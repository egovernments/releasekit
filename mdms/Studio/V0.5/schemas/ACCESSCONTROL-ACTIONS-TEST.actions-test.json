{
    "type": "object",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "required": [
        "id"
    ],
    "x-unique": [
        "id"
    ],
    "properties": {
        "id": {
            "type": "number"
        },
        "url": {
            "type": "string"
        },
        "code": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "path": {
            "type": "string"
        },
        "enabled": {
            "type": "boolean"
        },
        "leftIcon": {
            "type": "string",
            "default": "dynamic:ContractIcon"
        },
        "displayName": {
            "type": "string"
        },
        "orderNumber": {
            "type": "number"
        },
        "serviceCode": {
            "type": "string"
        },
        "parentModule": {
            "type": "string"
        },
        "navigationURL": {
            "type": "string"
        }
    }
}