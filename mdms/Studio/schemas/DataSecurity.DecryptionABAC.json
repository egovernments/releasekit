                            "type": "object",
                            "properties": {
                                "attribute": {
                                    "type": "object",
                                    "properties": {
                                        "jsonPath": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "accessType": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}